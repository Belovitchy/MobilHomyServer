# Modèle du fichier .env (à copier en .env à la racine du projet, jamais versionné).
# Lu par Spring Boot via spring.config.import ; en production, utiliser de vraies
# variables d'environnement à la place.

# Mot de passe de la base SQL Server
DB_PASSWORD=change-me
# Facultatifs en dev (valeurs par défaut dans application.properties)
#DB_URL=jdbc:sqlserver://localhost:1433;databaseName=MOBILHOMY;encrypt=true;trustServerCertificate=true
#DB_USERNAME=sa
#CORS_ORIGINS=http://localhost:4200

# Secret de signature des JWT : Base64, 32 octets minimum. Pour en générer un :
#   PowerShell : [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
#   openssl rand -base64 32
JWT_SECRET=change-me
